# Almacenamiento compartido en la nube (Vercel KV / Upstash Redis).
#
# Estas variables las inyecta Vercel automáticamente al conectar un almacén
# "KV" o "Upstash for Redis" desde Storage > Marketplace en tu proyecto, así que
# normalmente NO tienes que rellenarlas a mano en producción.
#
# Copia este archivo a .env.local solo si quieres probar en local con `vercel dev`.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternativa (nombres de la integración de Upstash). Con uno de los dos pares basta.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: clave bajo la que se guarda el plano (por si quieres varios planos).
# PLANNER_KEY=planificador-mesas-boda

# Contraseña de acceso a la app. Si no se define, se usa la del código por defecto.
# Defínela en Vercel (Project Settings > Environment Variables) para cambiarla
# sin tocar el código.
# PLANNER_PASSWORD=MartayCarlos
